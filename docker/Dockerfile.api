# Local Docker API: the same FastAPI app, without Lambda adapter.
FROM python:3.12-slim-bookworm AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /uvx /bin/
WORKDIR /code
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.12-slim-bookworm
RUN useradd -m -u 10001 app
COPY --from=build /code/.venv /opt/venv
COPY evals /home/app/evals
ENV PATH="/opt/venv/bin:${PATH}" PYTHONUNBUFFERED=1 REPOGUIDE_EVAL_ROOT=/home/app/evals
USER app
WORKDIR /home/app
CMD ["uvicorn", "repoguide.main:app", "--host", "0.0.0.0", "--port", "8000"]
