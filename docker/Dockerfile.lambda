# Build from repository root; compile for linux/amd64 (Lambda single architecture).
# Compile native wheels in the same Amazon Linux 2023 environment as the
# AWS Lambda Python 3.12 runtime. A Debian-built venv can carry ABI mismatches.
FROM public.ecr.aws/lambda/python:3.12 AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /uvx /usr/local/bin/
WORKDIR /code
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable --python /var/lang/bin/python3.12
# Download public inference weights at BUILD time instead of every Lambda/Fargate cold start.
# If your network blocks Hugging Face, set --build-arg PRELOAD_MODELS=0 to troubleshoot,
# but do not expect acceptable cold-start latency until models are baked or served remotely.
ARG PRELOAD_MODELS=1
RUN mkdir -p /code/hf_cache && if [ "$PRELOAD_MODELS" = "1" ]; then \
      HF_HOME=/code/hf_cache /code/.venv/bin/python -c "from sentence_transformers import SentenceTransformer,CrossEncoder; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2'); CrossEncoder('cross-encoder/ms-marco-MiniLM-L6-v2')"; \
    fi

FROM public.ecr.aws/lambda/python:3.12
COPY --from=build /code/.venv /opt/venv
COPY --from=build /code/hf_cache /opt/hf_cache
COPY evals ${LAMBDA_TASK_ROOT}/evals
ENV PATH="/opt/venv/bin:${PATH}" PYTHONPATH="/opt/venv/lib/python3.12/site-packages" PYTHONUNBUFFERED=1 HF_HOME=/opt/hf_cache HF_HUB_OFFLINE=1 REPOGUIDE_EVAL_ROOT=/var/task/evals
# Model weights are preloaded at build time unless PRELOAD_MODELS=0.
# Lambda cold start, 29s HTTP API integration latency and /tmp remain to be measured.
CMD ["repoguide.cloud_lambda.handler"]
