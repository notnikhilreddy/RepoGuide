# Local development only; never commit the real .env file
DATABASE_URL=postgresql+psycopg://repoguide:repoguide@localhost:5432/repoguide

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_SERVICE_TIER=default
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_MAX_INPUT_CHARS=32000
CONTEXT_CHAR_BUDGET=12000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:4b

CONTEXT7_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
REDIS_URL=redis://localhost:6379/0
# Optional cloud REST cache; leave blank for local Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT=RepoGuide
# Explicit opt-in for prompt, source code, answer and auto-SDK payloads
MLFLOW_CAPTURE_CONTENT=false
MLFLOW_AUTOLOG=false

ROUTER_PROVIDER=llm

# When using Jev, set ROUTER_PROVIDER=jev and configure the credentials
JEV_API_KEY=
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
ROUTER_SUFFICIENCY_THRESHOLD=0.75
