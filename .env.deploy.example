# Copy to .env.deploy and chmod 600 before adding credentials.
# One source file for scripts/update_runtime_settings.py; values are literal.
DATABASE_URL=
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_SERVICE_TIER=default
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_MAX_INPUT_CHARS=32000
CONTEXT_CHAR_BUDGET=12000
GEMINI_API_KEY=
# Set GEMINI_MODEL to your chosen model; blank retains the remote/default value.
GEMINI_MODEL=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
CONTEXT7_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
REDIS_URL=
# Cloud cache uses HTTPS REST, not the Redis TCP URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=RepoGuide
MLFLOW_CAPTURE_CONTENT=false
MLFLOW_AUTOLOG=false
ROUTER_PROVIDER=llm
JEV_API_KEY=
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
ROUTER_SUFFICIENCY_THRESHOLD=0.75
