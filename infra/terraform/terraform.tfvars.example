# Build/evaluate both images before filling these immutable references.
aws_region = "us-east-2"
frontend_origin = "https://repo-guide-five.vercel.app"
alert_email = "nikhilreddy.maligireddy2@gmail.com"
worker_image_uris = {
  answer = "ACCOUNT.dkr.ecr.us-east-2.amazonaws.com/repoguide-demo/answer@sha256:DIGEST"
  index = "ACCOUNT.dkr.ecr.us-east-2.amazonaws.com/repoguide-demo/index@sha256:DIGEST"
}

# Keep false for initial migration/API rollout; enable after owner-isolation smoke.
enable_public_registration = false
